# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs / crashes
**/logs/
**/crash-reports/
**/hs_err_pid*.log

# Minecraft temporary / cache-ish files
**/server-icon.png
**/session.lock

# Python caches
**/__pycache__/

# Optional: launcher/cache files if accidentally copied
**/.mixin.out/
**/cache/

# Local staging and generated outputs
.local-checkpoints/
.local-releases/
dist/
**/backups/

# Archive formats (do not commit checkpoints)
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Local Minecraft client/launcher caches and risky launch artifacts
packs/*/extras/local/crash_assistant/
packs/*/extras/local/**/crash_assistant/
packs/*/extras/local/**/*.jar
packs/*/extras/local/**/*.dll
packs/*/extras/local/**/*_args.info
packs/*/extras/local/**/username.info
